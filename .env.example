# Optional. Never commit .env or real secrets.
PORT=4173
# Set the exact external HTTPS origin in production, no trailing slash.
PUBLIC_ORIGIN=http://localhost:4173
# Google sign-in needs both values. Email sign-in also uses the session secret.
GOOGLE_CLIENT_ID=
APEX_SESSION_SECRET=

# Optional server-only OpenF1 Sponsor bearer token. Never embed in Android/browser assets.
OPENF1_ACCESS_TOKEN=

# Persistent directory for prediction leagues (default: .apex-data).
# On a hosted container, mount a persistent disk/volume at this path.
APEX_DATA_DIR=

# Optional OpenF1 subscriber credentials for automatic token renewal.
OPENF1_USERNAME=
OPENF1_PASSWORD=

# Optional email one-time-code sign-in. Use a verified Resend sender and persistent storage.
RESEND_API_KEY=
APEX_EMAIL_FROM=
